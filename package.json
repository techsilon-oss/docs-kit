{
  "name": "docs-kit",
  "version": "0.4.0",
  "description": "One layout for docs/ in any repo: a check that keeps it, and a mover that keeps every link and path working.",
  "license": "Apache-2.0",
  "author": "Techsilon LLC <oss@techsilon.com>",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techsilon-oss/docs-kit.git"
  },
  "bin": {
    "docs-kit": "scripts/docs-kit.mjs"
  },
  "files": [
    "scripts/",
    "examples/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "check": "node scripts/docs-kit.mjs check"
  }
}
